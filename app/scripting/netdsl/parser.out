FROM                 : 1 2
IP_ADDRESS           : 3 4 5 6
MAC_ADDRESS          : 4 5 7
NUMBER               : 3 5 9
OPERATOR             : 8 9
OR                   : 
TO                   : 1 2
VALUE                : 8
WHERE                : 12
error                : 

